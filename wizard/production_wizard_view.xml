<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_production_method_wizard_form" model="ir.ui.view">
        <field name="name">production.method.wizard.form</field>
        <field name="model">production.method.wizard</field>
        <field name="arch" type="xml">
            <form string="Cấu hình Phương Án Sản Xuất">
                <group>
                    <field name="order_id" readonly="1"/>
                </group>
                <field name="line_ids">
                    <list editable="bottom">
                        <field name="sub_component_id"/>
                        <field name="qty_to_produce"/>
                        <field name="production_method"/>
                    </list>
                </field>

                <footer>
                    <button name="action_confirm_production" string="Xác nhận &amp; Tạo Lệnh" type="object" class="btn-primary"/>
                    <button string="Hủy" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>