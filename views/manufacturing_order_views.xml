<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_manufacturing_order_form" model="ir.ui.view">
        <field name="name">manufacturing.order.form</field>
        <field name="model">manufacturing.order</field>
        <field name="arch" type="xml">
            <form string="Lệnh Sản Xuất">
                <header>
                    <button name="action_confirm"
                            string="Đã xác nhận"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="action_progress"
                            string="Bắt đầu thực hiện"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'confirmed'"/>

                    <button name="action_done"
                            string="Hoàn thành"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'progress'"/>

                    <button name="action_cancel"
                            string="Đã hủy"
                            type="object"
                            class="btn-primary"
                            invisible="state in ('done', 'cancel')"/>

                    <button name="action_draft"
                            string="Nháp"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'cancel'"/>

                    <field name="state"
                        widget="statusbar"
                        statusbar_visible="draft,confirmed,progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="product_id" class="oe_edit_only" string="Tên sản phẩm"/>
                        <h1>
                            <field name="product_id" placeholder="Nhập tên sản phẩm..."/>
                        </h1>   
                    </div>
                    <group>
                        <group>
                            <field name="mo_id"/>
                            <field name="customer_name"/>
                            <field name="bom_id"/>
                            <field name="product_qty"/>
                        </group>
                        <group>
                            <field name="product_color" widget="radio"/>
                            <field name="sale_cost"/>
                            <field name="date_deadline" widget="remaining_days"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Thành phần linh kiện">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sub_component_id"/>
                                    <field name="note" width="250px"/>
                                    <field name="quantity" width="150px"/>
                                    <field name="available_qty"/>
                                </list>
                            </field>
                        </page>
                        <page string="Phân công công đoạn" name="workorders">
                            <field name="operation_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name" string="Tên công việc"/>
                                    <field name="component_id" string="Linh kiện gia công" widget="many2many_tags"/>
                                    
                                    <field name="team_id" string="Nhóm phụ trách"/>
                                    <field name="machine_id" string="Máy thực hiện" domain="[('team_id', '=', team_id)]"/>
                                    <field name="expect_duration" string="Dự kiến (phút)"/>
                                    <field name="real_duration" string="Thực tế (phút)"/>
                                    <field name="state" widget="badge" 
                                           decoration-info="state == 'pending'" 
                                           decoration-warning="state == 'ready'" 
                                           decoration-primary="state == 'progress'" 
                                           decoration-success="state == 'done'"/>
                                    <field name="date_start" optional="hide"/>
                                    <field name="date_end" optional="hide"/>
                                    <button name="action_start" type="object" string="Bắt đầu" 
                                            icon="fa-play" class="btn-primary btn-sm" 
                                            invisible="state not in ('pending', 'ready', 'pause')"/>
                                    <button name="action_done" type="object" string="Hoàn tất" 
                                            icon="fa-check" class="btn-success btn-sm" 
                                            invisible="state != 'progress'"/>
                                    <field name="quantity" string="Số lượng"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_manufacturing_order_list" model="ir.ui.view">
        <field name="name">manufacturing.order.list</field>
        <field name="model">manufacturing.order</field>
        <field name="arch" type="xml">
            <list string="Danh sách Lệnh Sản Xuất">
                <field name="mo_id"/>
                <field name="product_id"/>
                <field name="customer_name" width="150px"/>
                <field name="date_deadline" widget="remaining_days" width="140px"/>
                <field name="state" widget="badge" width="150px"/>
                <field name="product_qty" width="150px"/>
            </list>
        </field>
    </record>

    <record id="action_manufacturing_order" model="ir.actions.act_window">
        <field name="name">Lệnh Sản Xuất</field>
        <field name="res_model">manufacturing.order</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>