<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_production" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.production</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_production_wizard" 
                        type="object" 
                        string="Lên Phương Án Sản Xuất" 
                        class="oe_highlight" 
                        invisible="state != 'sale'"/> 
            </xpath>
        </field>
    </record>
</odoo>