<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. FORM VIEW -->
    <record id="view_product_bom_form" model="ir.ui.view">
        <field name="name">product.bom.form</field>
        <field name="model">product.bom</field>
        <field name="arch" type="xml">
            <form string="Định mức nguyên vật liệu (BoM)">
                <sheet>
                    <div class="oe_title">
                        <label for="code" string="Mã định mức"/>
                        <h1>
                            <field name="code" placeholder="VD: BOM-001" default_focus="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_id" string="Sản phẩm hoàn thiện"/>
                        </group>
                        <group>
                            <field name="product_qty" string="Số lượng thành phẩm"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Danh sách linh kiện / Vật tư" name="bom_lines">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="component_id" string="Linh kiện / Bán thành phẩm"/>
                                    <field name="product_qty" string="Số lượng tiêu hao"/>
                                    <field name="uom_name" string="Đơn vị tính"/>
                                    <field name="production_method" string="Cách cung ứng"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 2. TREE / LIST VIEW -->
    <record id="view_product_bom_list" model="ir.ui.view">
        <field name="name">product.bom.list</field>
        <field name="model">product.bom</field>
        <field name="arch" type="xml">
            <tree string="Danh sách định mức BoM">
                <field name="code" string="Mã BoM"/>
                <field name="product_id" string="Sản phẩm hoàn thiện"/>
                <field name="product_qty" string="Số lượng"/>
            </tree>
        </field>
    </record>

    <!-- 3. ACTION WINDOW -->
    <record id="action_product_bom" model="ir.actions.act_window">
        <field name="name">Định mức BoM</field>
        <field name="res_model">product.bom</field>
        <field name="view_mode">tree,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_product_bom_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_product_bom_form')}),
        ]"/>
    </record>
</odoo>