<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_bom_form" model="ir.ui.view">
        <field name="name">product.bom.form</field>
        <field name="model">product.bom</field>
        <field name="arch" type="xml">
            <form string="Lệnh sản xuất">
                <sheet>
                    <div class="oe_title">
                        <label for="product_name" string="Tên hàng"/>
                        <h1>
                            <field name="product_name"
                                placeholder="VD: Pin"
                                default_focus="1"
                                options="{'line_breaks': False}"
                                class="w-100 text-break"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_code"/>
                            <field name="customer_name"/>
                            <field name="delivery_date"/>
                        </group>
                        <group>
                            <field name="date_finished"/>
                            <field name="manufacturing_date"/>
                        </group>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="view_product_bom_list" model="ir.ui.view">
        <field name="name">product.bom.list</field>
        <field name="model">product.bom</field>
        <field name="arch" type="xml">
            <list string="Lệnh sản xuất">
                <field name="product_code" string="Mã hàng" width="100px"/>
                <field name="product_name" string="Tên hàng"/>
                <field name="customer_name" string="Khách hàng"/>
                <field name="manufacturing_date" string="Ngày sản xuất" width="150px"/>
                <field name="delivery_date" string="Ngày giao" width="140px"/>
                <field name="date_finished" string="Ngày nhập" width="120px"/>
                <field name="note" string="Ghi chú khác"/>
            </list>
        </field>
    </record>

    <record id="action_product_bom" model="ir.actions.act_window">
        <field name="name">Nhập lệnh sản xuất</field>
        <field name="res_model">finished.product</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
                    (0, 0, {'view_mode': 'list', 'view_id': ref('view_product_bom_list')}),
                    (0, 0, {'view_mode': 'form', 'view_id': ref('view_product_bom_form')}),
                ]"/>
    </record>


    

</odoo>