<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_bom_form" model="ir.ui.view">
        <field name="name">product.bom.form</field>
        <field name="model">product.bom</field>
        <field name="arch" type="xml">
            <form string="Định mức &amp; Lệnh sản xuất">
                <sheet>
                    <div class="oe_title">
                        <label for="product_name" string="Tên hàng"/>
                        <h1>
                            <field name="product_name"
                                   placeholder="VD: Ấm siêu tốc 1.8L"
                                   default_focus="1"
                                   class="w-100 text-break"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Thông tin sản phẩm &amp; Đơn hàng">
                            <field name="product_code" placeholder="Mã hàng (VD: AST-01)"/>
                            <field name="customer_name" placeholder="Tên khách hàng/Đối tác"/>
                            <field name="delivery_date"/>
                        </group>
                        <group string="Tiến độ sản xuất">
                            <field name="manufacturing_date"/>
                            <field name="date_finished"/>
                        </group>
                    </group>

                    <!-- TAB CHI TIẾT LINH KIỆN CỦA BOM -->
                    <notebook>
                        <page string="Danh sách linh kiện / Cụm bộ phận" name="bom_components">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="component_id" string="Linh kiện"/>
                                    <field name="product_qty" string="Số lượng"/>
                                    <field name="uom_name" string="Đơn vị"/>
                                    <field name="production_method" string="Phương thức cung ứng"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Ghi chú" name="notes">
                            <field name="note" placeholder="Nhập ghi chú kỹ thuật hoặc yêu cầu gia công..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="view_product_bom_list" model="ir.ui.view">
        <field name="name">product.bom.list</field>
        <field name="model">product.bom</field>
        <field name="arch" type="xml">
            <list string="Danh sách định mức BoM">
                <field name="product_code" string="Mã hàng"/>
                <field name="product_name" string="Tên hàng"/>
                <field name="customer_name" string="Khách hàng"/>
                <field name="manufacturing_date" string="Ngày sản xuất"/>
                <field name="delivery_date" string="Ngày giao"/>
                <field name="date_finished" string="Ngày hoàn thành"/>
                <field name="note" string="Ghi chú khác"/>
            </list>
        </field>
    </record>

    <!-- 3. WINDOW ACTION (Đã sửa đúng res_model về product.bom) -->
    <record id="action_product_bom" model="ir.actions.act_window">
        <field name="name">Nhập lệnh sản xuất</field>
        <field name="res_model">product.bom</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
                    (0, 0, {'view_mode': 'list', 'view_id': ref('view_product_bom_list')}),
                    (0, 0, {'view_mode': 'form', 'view_id': ref('view_product_bom_form')}),
                ]"/>
    </record>
</odoo>