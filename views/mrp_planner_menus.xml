<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_mrp_planner_orders" model="ir.actions.act_window">
        <field name="name">Đơn chờ sản xuất</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'sale')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Chưa có đơn hàng nào cần lên kế hoạch sản xuất!
            </p>
        </field>
    </record>

    <menuitem id="menu_mrp_planner_root" 
              name="Kế Hoạch SX" 
              sequence="10" />

    <menuitem id="menu_production_order" 
              name="Đơn Sản Xuất" 
              parent="menu_mrp_planner_root" 
              action="action_production_order" 
              sequence="10"/>

    <menuitem id="menu_sub_component" 
              name="Kho sản phẩm" 
              parent="menu_mrp_planner_root" 
              action="action_sub_component" 
              sequence="20"/>



</odoo>