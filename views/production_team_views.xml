<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_production_team_list" model="ir.ui.view">
        <field name="name">production.team.list</field>
        <field name="model">production.team</field>
        <field name="arch" type="xml">
            <list string="Nhóm Sản Xuất">
                <field name="name"/>
                <field name="leader_id"/>
                <field name="member_ids" widget="many2many_tags"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_production_team_form" model="ir.ui.view">
        <field name="name">production.team.form</field>
        <field name="model">production.team</field>
        <field name="arch" type="xml">
            <form string="Nhóm Sản Xuất">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Tên nhóm sản xuất"/>
                        <h1>
                            <field name="name" placeholder="VD: Đội Phay Tiện, Nhóm Hàn Lắp Ráp..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="leader_id"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="member_ids" widget="many2many_tags" placeholder="Chọn các kỹ thuật viên..."/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Mô tả công việc &amp; Ghi chú">
                            <field name="note" placeholder="Quy định, nhiệm vụ chính của nhóm..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_production_team" model="ir.actions.act_window">
        <field name="name">Nhóm Sản Xuất</field>
        <field name="res_model">production.team</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>