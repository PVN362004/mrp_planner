<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. FORM VIEW (Xem và sửa chi tiết 1 Work Order) -->
    <record id="view_product_order_form" model="ir.ui.view">
        <field name="name">product.order.form</field>
        <field name="model">product.order</field>
        <field name="arch" type="xml">
            <form string="Lệnh làm việc (Work Order)">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="pending,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Mã / Tên công đoạn"/>
                        <h1>
                            <field name="name" placeholder="VD: WO-Dập vỏ / WO-Lắp ráp" default_focus="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Sản phẩm liên quan">
                            <field name="planner_id" string="Sản phẩm"/>
                            <field name="product_code" string="Mã hàng"/>
                            <field name="product_name" string="Tên hàng"/>
                            <field name="bom" string="Định mức BoM"/>
                        </group>
                        <group string="Kế hoạch thực hiện">
                            <field name="stage" string="Công đoạn"/>
                            <field name="quantity" string="Số lượng làm"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_product_order_tree" model="ir.ui.view">
        <field name="name">product.order.tree</field>
        <field name="model">product.order</field>
        <field name="arch" type="xml">
            <list string="Danh sách Work Orders" decoration-info="status == 'pending'" decoration-warning="status == 'in_progress'" decoration-success="status == 'done'">
                <field name="name" string="Mã WO"/>
                <field name="planner_id" string="Sản phẩm"/>
                <field name="product_code" string="Mã hàng"/>
                <field name="stage" string="Công đoạn"/>
                <field name="quantity" string="SL"/>
                <field name="bom" string="BoM"/>
                <field name="status" widget="badge"
                       decoration-info="status == 'pending'"
                       decoration-warning="status == 'in_progress'"
                       decoration-success="status == 'done'"/>
            </list>
        </field>
    </record>

    <record id="action_product_order" model="ir.actions.act_window">
        <field name="name">Lệnh làm việc (Work Orders)</field>
        <field name="res_model">product.order</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_product_order_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_product_order_form')}),
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo Lệnh làm việc (Work Order) đầu tiên của bạn!
            </p>
        </field>
    </record>
</odoo>