<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_list_form" model="ir.ui.view">
        <field name="name">product.planner.form</field>
        <field name="model">product.planner</field>
        <field name="arch" type="xml">
            <form string="Nhập thông tin sản phẩm">
                <sheet>
                    <div class="oe_title">
                        <label for="product_name" string="Tên hàng"/>
                        <h1>
                            <field name="product_name"
                                placeholder="VD: Ấm siêu tốc / Pin"
                                default_focus="1"
                                options="{'line_breaks': False}"
                                class="w-100 text-break"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_code"/>
                            <field name="company"/>
                        </group>
                        <group>
                            <field name="product_quantity"/>
                            <field name="product_type" widget="radio"/>
                        </group>
                    </group>
                    <group>
                        <field name="product_description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="view_product_list_list" model="ir.ui.view">
        <field name="name">product.planner.list</field>
        <field name="model">product.planner</field>
        <field name="arch" type="xml">
            <list string="Danh sách sản phẩm">
                <field name="product_code" string="Mã hàng" width="120px"/>
                <field name="product_name" string="Tên hàng"/>
                <field name="company" string="Tên công ty"/>
                <field name="product_type" string="Loại sản phẩm"/>
                <field name="product_description" string="Mô tả"/>
                <field name="product_quantity" string="Số lượng đơn"/>
            </list>
        </field>
    </record>

    <record id="action_product_list" model="ir.actions.act_window">
        <field name="name">Nhập thông tin sản phẩm</field>
        <field name="res_model">product.planner</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_product_list_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_product_list_form')}),
        ]"/>
    </record>
</odoo>