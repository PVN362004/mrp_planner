<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================== -->
    <!-- 1. VIEWS CHO KHO SẢN PHẨM (SUB COMPONENT)      -->
    <!-- ============================================== -->
    <record id="view_sub_component_form" model="ir.ui.view">
        <field name="name">sub.component.form</field>
        <field name="model">sub.component</field>
        <field name="arch" type="xml">
            <form string="Kho sản phẩm">
                <sheet>
                    <div class="oe_title">
                        <label for="component_name" string="Tên hàng"/>
                        <h1>
                            <field name="component_name"
                                placeholder="VD: Pin"
                                default_focus="1"
                                options="{'line_breaks': False}"
                                class="w-100 text-break"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="component_id"/>
                            <field name="quantity"/>
                        </group>
                        <group>
                            <field name="component_method"/>
                            <field name="company_name"/>
                            <field name="buying_cost"/>
                            <field name="sale_cost"/>
                        </group>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="view_sub_component_list" model="ir.ui.view">
        <field name="name">sub.component.list</field>
        <field name="model">sub.component</field>
        <field name="arch" type="xml">
            <list string="Kho sản phẩm">
                <field name="component_id" string="Mã sản phẩm" width="100px"/>
                <field name="component_name" string="Tên sản phẩm"/>
                <field name="component_method" string="Phương thức sản xuất"/>
                <field name="company_name" string="Tên công ty" width="150px"/>
                <field name="buying_cost" string="Giá mua" width="140px"/>
                <field name="sale_cost" string="Giá bán" width="140px"/>
                <field name="quantity" string="Số lượng" width="120px"/>
                <field name="note" string="Ghi chú khác"/>
            </list>
        </field>
    </record>

    <record id="action_sub_component" model="ir.actions.act_window">
        <field name="name">Kho sản phẩm</field>
        <field name="res_model">sub.component</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
                    (0, 0, {'view_mode': 'list', 'view_id': ref('view_sub_component_list')}),
                    (0, 0, {'view_mode': 'form', 'view_id': ref('view_sub_component_form')}),
                ]"/>
    </record>

    <!-- ============================================== -->
    <!-- 2. VIEWS CHO KHO SẢN XUẤT (PRODUCTION STOCK)   -->
    <!-- ============================================== -->
    <!-- Form View cho Kho -->
    <record id="view_production_stock_form" model="ir.ui.view">
        <field name="name">production.stock.form</field>
        <field name="model">production.stock</field>
        <field name="arch" type="xml">
            <form string="Kho Sản Xuất">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="stock_name" placeholder="Tên kho..."/>
                        </h1>
                    </div>
                    <group>
                        <field name="location_code"/>
                    </group>
                    <notebook>
                        <page string="Danh sách sản phẩm tồn kho">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_name"/>
                                    <field name="quantity" sum="Tổng số lượng"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View cho Kho -->
    <record id="view_production_stock_list" model="ir.ui.view">
        <field name="name">production.stock.list</field>
        <field name="model">production.stock</field>
        <field name="arch" type="xml">
            <list string="Danh sách Kho">
                <field name="stock_name"/>
                <field name="location_code"/>
            </list>
        </field>
    </record>

    <!-- Action Window cho Kho -->
    <record id="action_production_stock" model="ir.actions.act_window">
        <field name="name">Kho Sản Xuất</field>
        <field name="res_model">production.stock</field>
        <field name="view_mode">list,form</field>
    </record>


</odoo>